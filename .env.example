# GhostWriter Configuration
# Local Ollama service endpoint (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Primary horror generation model (Recommended: qwen2.5:3b or llama3.2:latest)
GHOSTWRITER_MODEL=qwen2.5:3b

# Request timeout in seconds for local model inference
OLLAMA_TIMEOUT=90

# Generation creativity / temperature (0.1 to 1.0; 0.7 - 0.8 recommended for horror fiction)
DEFAULT_TEMPERATURE=0.75

